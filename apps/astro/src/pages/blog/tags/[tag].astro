---
/**
 * Dusk UI — 单标签文章列表
 */

import BlogLayout from '../../../layouts/BlogLayout.astro'
import { getPostsByTag, getTagsWithCount, PostCard } from '@dusk-ui/ui/demo'

export function getStaticPaths() {
  return getTagsWithCount().map((tag) => ({
    params: { tag: tag.slug },
    props: { name: tag.name, count: tag.count },
  }))
}

interface Props {
  name: string
  count: number
}

const { name, count } = Astro.props
const posts = getPostsByTag(Astro.params.tag)
---

<BlogLayout title={`#${name} · Dusklight`} description={`标签「${name}」下的文章列表。`}>
  <main class="mx-auto max-w-[var(--page-max-width)] px-[var(--gutter)] py-10">
    <nav class="text-xs text-foreground-muted">
      <a href="/blog" class="transition-colors hover:text-foreground">博客</a>
      <span aria-hidden="true"> / </span>
      <a href="/blog/tags" class="transition-colors hover:text-foreground">标签</a>
    </nav>

    <h1 class="mt-3 text-2xl">
      <span aria-hidden="true" class="text-foreground-muted">#</span>
      {name}
    </h1>
    <p class="mt-3 text-sm text-foreground-secondary">共 {posts.length} 篇文章</p>

    {
      posts.length > 0 ? (
        <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="mt-8 rounded-card border border-border bg-surface-1 p-6 text-sm text-foreground-secondary">
          这个标签下还没有文章。
        </p>
      )
    }

    <p class="mt-8 text-xs text-foreground-muted">
      该标签共 {count} 篇 ·
      <a href="/blog/tags" class="ml-1 transition-colors hover:text-foreground">返回标签索引</a>
    </p>
  </main>
</BlogLayout>
