---
/**
 * Dusk UI — 标签索引
 */

import BlogLayout from '../../../layouts/BlogLayout.astro'
import { getTagsWithCount } from '@dusk-ui/ui/demo'

const tags = getTagsWithCount()
const total = tags.reduce((sum, tag) => sum + tag.count, 0)
---

<BlogLayout title="标签 · Dusklight" description="全部标签及其文章数量。">
  <main class="mx-auto max-w-[var(--page-max-width)] px-[var(--gutter)] py-10">
    <h1 class="text-2xl">标签</h1>
    <p class="mt-3 max-w-[52ch] text-sm leading-relaxed text-foreground-secondary">
      {tags.length} 个标签，共 {total} 次标记。标签按文章数量倒序排列。
    </p>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        tags.map((tag) => (
          <a
            href={`/blog/tags/${tag.slug}`}
            class="flex items-center justify-between gap-3 rounded-card border border-border bg-surface-1 p-5 transition-colors duration-[150ms] ease-[var(--ease-standard)] hover:border-border-strong hover:bg-surface-2"
          >
            <span class="min-w-0">
              <span class="block truncate text-md font-medium">{tag.name}</span>
              <span class="mt-1 block truncate text-xs text-foreground-muted">/blog/tags/{tag.slug}</span>
            </span>
            <span class="shrink-0 rounded-pill bg-accent-subtle px-2.5 py-0.5 text-xs text-accent [font-variant-numeric:tabular-nums]">
              {tag.count} 篇
            </span>
          </a>
        ))
      }
    </div>
  </main>
</BlogLayout>
