---
/**
 * Dusk UI — 文章详情
 * ─────────────────────────────────────────────────────────
 * 每篇文章在构建时生成一个静态页面，正文由结构化块渲染，
 * 不引入 Markdown 渲染器，也不附加任何客户端岛。
 */

import BlogLayout from '../../../layouts/BlogLayout.astro'
import {
  ArchiveItem,
  BLOG_AUTHOR,
  BLOG_POSTS,
  BLOG_SITE,
  categoryName,
  CoverArt,
  formatDate,
  getAdjacentPosts,
  hasUpdate,
  PostBody,
  PostMeta,
  PostNav,
  TagPill,
  type BlogPost,
} from '@dusk-ui/ui/demo'

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

interface Props {
  post: BlogPost
}

const { post } = Astro.props
const { newer, older } = getAdjacentPosts(post.slug)
const related = BLOG_POSTS.filter(
  (item) => item.slug !== post.slug && item.category === post.category,
).slice(0, 3)
/** 发布之后就没改过的文章没有更新时间，两处都按这个结果渲染 */
const updatedAt = hasUpdate(post) ? post.updated : undefined
---

<BlogLayout title={`${post.title} · ${BLOG_SITE.name}`} description={post.excerpt}>
  <main class="mx-auto max-w-[var(--page-max-width)] px-[var(--gutter)] py-10">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_16rem]">
      <article class="min-w-0">
        <CoverArt cover={post.cover} className="aspect-[16/9] lg:aspect-[21/9]" />

        <h1 class="mt-6 text-2xl">{post.title}</h1>

        <div class="mt-4">
          <PostMeta
            date={post.date}
            updated={post.updated}
            category={post.category}
            readingTime={post.readingTime}
            categoryHref={`/blog/categories/${post.category}`}
          />
        </div>

        <div
          class="mt-6 flex items-center gap-3 border-y border-border-subtle py-3 text-sm text-foreground-secondary"
        >
          <span
            aria-hidden="true"
            class="grid size-9 shrink-0 place-items-center rounded-pill bg-accent text-accent-foreground"
          >
            {BLOG_AUTHOR.avatar}
          </span>
          <span>{BLOG_AUTHOR.name}</span>
          <span aria-hidden="true" class="text-foreground-muted">·</span>
          <span class="text-foreground-muted">{BLOG_AUTHOR.role}</span>
        </div>

        <div class="max-w-[68ch]">
          <PostBody blocks={post.body} />
        </div>

        <div class="mt-10">
          <h2 class="text-md">本文标签</h2>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {post.tags.map((tag) => <TagPill label={tag} href={`/blog/tags/${tag}`} />)}
          </div>
        </div>

        <div class="mt-8">
          <PostNav newer={newer} older={older} />
        </div>
      </article>

      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-card border border-border bg-surface-1 p-5">
          <h2 class="text-md">文章信息</h2>
          <dl class="mt-3 space-y-2 text-sm">
            <div class="flex justify-between gap-3">
              <dt class="text-foreground-muted">发布</dt>
              <dd><time datetime={post.date}>{formatDate(post.date)}</time></dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-foreground-muted">更新</dt>
              {
                updatedAt ? (
                  <dd>
                    <time datetime={updatedAt}>{formatDate(updatedAt)}</time>
                  </dd>
                ) : (
                  <dd class="text-foreground-muted">未修改</dd>
                )
              }
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-foreground-muted">分类</dt>
              <dd>{categoryName(post.category)}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-foreground-muted">阅读</dt>
              <dd>{post.readingTime}</dd>
            </div>
          </dl>
        </div>

        {
          related.length > 0 ? (
            <div class="rounded-card border border-border bg-surface-1 p-5">
              <h2 class="text-md">同分类文章</h2>
              <ul class="mt-3">
                {related.map((item) => <ArchiveItem post={item} />)}
              </ul>
            </div>
          ) : null
        }

        <div class="rounded-card border border-border bg-surface-1 p-5">
          <h2 class="text-md">关于本站</h2>
          <p class="mt-2 text-sm leading-relaxed text-foreground-secondary">
            {BLOG_SITE.description}
          </p>
          <a
            href="/blog/about"
            class="mt-3 inline-flex text-sm text-accent transition-opacity hover:opacity-80"
          >
            了解作者 →
          </a>
        </div>
      </aside>
    </div>
  </main>
</BlogLayout>
