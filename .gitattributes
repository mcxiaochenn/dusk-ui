# 统一换行符，避免 Windows / macOS / Linux 协作时产生整文件 diff
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# 锁文件参与 diff 会污染评审，折叠显示
package-lock.json linguist-generated=true

# 截图属于验证产物，不计入语言统计
docs/screenshots/* linguist-documentation=true
